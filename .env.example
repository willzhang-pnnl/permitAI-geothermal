# Copy this file to .env.local and fill in your own token.
# Only needed for gated/private Hugging Face datasets - public datasets work without it.
#
# WARNING: This app is a static site (e.g. GitHub Pages). Any value placed in a
# VITE_ prefixed env var is bundled into the public JS and is visible to anyone
# who opens the site. Do not use a token with write/full-access scope here, and
# do not commit real tokens to source control.
VITE_HF_TOKEN=
VITE_HF_DATASET_REPO=PNNL/PermitTECv0.1
VITE_HF_DATASET_FILE=dataset.json
